{
  "expo": {
    "name": "Proven Power",
    "slug": "proven-power-mobile",
    "owner": "tegnarski",
    "scheme": "provenpower",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Proven Power needs access to your photos to add pictures of your equipment.",
          "cameraPermission": "Proven Power needs access to your camera to take pictures of your equipment."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.provenpower.mobile"
    },
    "android": {
      "package": "com.provenpower.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "137bfc06-844f-434e-b7c0-c690a1722b53"
      }
    }
  }
}
